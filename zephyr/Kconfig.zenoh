config ZENOH_PICO
	bool "Zenoh PICO library"
	help
	  Enable Zenoh pico support

if ZENOH_PICO

choice ZENOH_PICO_ZEPHYR_THREADS
	prompt "zenoh-pico platform backend"
	default ZENOH_PICO_ZEPHYR_THREADS_NATIVE
	help
	  Selects how the zenoh-pico Zephyr platform layer implements tasks,
	  mutexes, condition variables, and the monotonic clock.

config ZENOH_PICO_ZEPHYR_THREADS_NATIVE
	bool "Native Zephyr kernel primitives"
	help
	  Implement zenoh-pico tasks with k_thread, mutexes with k_mutex,
	  condition variables with k_condvar, and the monotonic clock from
	  kernel uptime. Kernel objects live in zenoh-pico owned memory, so
	  no POSIX object pool sizing (MAX_PTHREAD_MUTEX_COUNT and friends)
	  applies and POSIX threading support is not required.

config ZENOH_PICO_ZEPHYR_THREADS_POSIX
	bool "POSIX pthread primitives"
	depends on POSIX_API || POSIX_THREADS
	help
	  Implement the zenoh-pico platform layer on the POSIX portability
	  layer. The global POSIX object pools must then be sized for the
	  session posture, in particular MAX_PTHREAD_MUTEX_COUNT and
	  MAX_PTHREAD_COND_COUNT.

endchoice

config ZENOH_PICO_ZEPHYR_TASK_POOL_SIZE
	int "Maximum concurrent zenoh-pico tasks"
	depends on ZENOH_PICO_ZEPHYR_THREADS_NATIVE
	default 4
	range 1 16
	help
	  Number of slots in the static task pool. Each open session with the
	  background read task holds one slot, and each z_task_init call with
	  a pool stack holds one slot until the task is joined or a detached
	  task terminates. Slots are reused across session restarts.

config ZENOH_PICO_ZEPHYR_TASK_STACK_SIZE
	int "zenoh-pico task stack size"
	depends on ZENOH_PICO_ZEPHYR_THREADS_NATIVE
	default MAIN_STACK_SIZE
	help
	  Stack size in bytes for each slot of the static task pool.

config ZENOH_PICO_ZEPHYR_TASK_PRIORITY_CUSTOM
	bool "Set a custom zenoh-pico task priority"
	depends on ZENOH_PICO_ZEPHYR_THREADS_NATIVE
	help
	  Pool tasks default to K_LOWEST_APPLICATION_THREAD_PRIO, the same
	  priority the POSIX layer gives pthreads. Enable to choose an
	  explicit Zephyr priority instead.

config ZENOH_PICO_ZEPHYR_TASK_PRIORITY
	int "zenoh-pico task priority"
	depends on ZENOH_PICO_ZEPHYR_TASK_PRIORITY_CUSTOM
	default 0
	help
	  Zephyr thread priority for pool tasks. Lower numbers run first and
	  negative values are cooperative.

config ZENOH_PICO_LINK_SERIAL
	bool "Serial Link"
	help
	  Use serial link

config ZENOH_PICO_MULTI_THREAD
	bool "Multithreading support"
	help
	  Multithreading support

config ZENOH_PICO_PUBLICATION
	bool "Publication Support"
	help
	  Publication support

config ZENOH_PICO_SUBSCRIPTION
	bool "Subscription Support"
	help
	  Subscription Support

config ZENOH_PICO_QUERY
	bool "Query Support"
	help
	  Query Support

config ZENOH_PICO_QUERYABLE
	bool "Queryable Support"
	help
	  Queryable Support

config ZENOH_PICO_RAWETH_TRANSPORT
	bool "Raw Ethernet Support"
	help
	  Raw Ethernet Support

config ZENOH_PICO_LINK_TCP
	bool "TCP Link"
	help
	  TCP Link

config ZENOH_PICO_LINK_UDP_UNICAST
	bool "UDP Unicast"
	help
	  UDP Unicast

config ZENOH_PICO_LINK_UDP_MULTICAST
	bool "UDP Multicast"
	help
	  UDP Multicast

config ZENOH_PICO_SCOUTING
	bool "Scouting UDP"
	help
	  Scouting UDP

config ZENOH_PICO_LINK_WS
	bool "WS Link"
	help
	  WS Link

config ZENOH_PICO_ZEPHYR_SOCKET_PRIORITY
	bool "Mark zenoh sockets with a network priority (TSN class)"
	help
	  Set SO_PRIORITY on the zenoh-pico UDP and TCP sockets so the Zephyr
	  network stack and a downstream TSN switch can classify zenoh traffic
	  by class. Multicast (best-effort telemetry) and unicast or TCP
	  (reliable corrections and commands) take separate priorities, so they
	  can map to different egress queues or VLAN PCP values. For the switch
	  to see the priority as a PCP, the egress interface must be VLAN
	  tagged, otherwise the priority only steers the local TX queue.

config ZENOH_PICO_ZEPHYR_MULTICAST_PRIORITY
	int "Network priority for multicast (telemetry) sockets"
	depends on ZENOH_PICO_ZEPHYR_SOCKET_PRIORITY
	default 1
	range 0 7
	help
	  SO_PRIORITY applied to UDP multicast sockets, which carry best-effort
	  telemetry on the router-less mesh.

config ZENOH_PICO_ZEPHYR_UNICAST_PRIORITY
	int "Network priority for unicast and TCP (control) sockets"
	depends on ZENOH_PICO_ZEPHYR_SOCKET_PRIORITY
	default 5
	range 0 7
	help
	  SO_PRIORITY applied to UDP unicast and TCP sockets, which carry the
	  reliable corrections and command traffic.

endif
